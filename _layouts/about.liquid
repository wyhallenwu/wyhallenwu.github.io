---
layout: default
---
<div class="post">
  <article>
    {% if page.profile %}
      <div class="about-intro-layout">
        <div class="profile about-profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% capture sizes %}(min-width: 720px) 220px, 38vw{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes=sizes alt="Portrait of Yuheng Wu"
              cache_bust=true
            %}
          {% endif %}
        </div>

        <div class="about-intro-content">
          <header class="about-identity">
            <h1 id="about-name">
              {{ site.first_name }}
              {{ site.middle_name }}
              {{ site.last_name }}
            </h1>
            {% if page.role %}
              <p class="about-identity__role">{{ page.role }}</p>
            {% endif %}
          </header>
          <div class="about-intro-copy">{{ content }}</div>
          {% if page.profile_links %}{% include about/profile_links.liquid %}{% endif %}
        </div>
      </div>
    {% else %}
      <div class="clearfix">{{ content }}</div>
    {% endif %}

    {% if page.education %}{% include about/education.liquid %}{% endif %}

    {% if page.internship %}{% include about/internship.liquid %}{% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="about-section about-news" aria-labelledby="news-title">
        <h2 id="news-title" class="about-section__title">
          <a href="{{ '/news/' | relative_url }}">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <section class="about-section about-publications" aria-labelledby="selected-publications-title">
      <h2 id="selected-publications-title" class="about-section__title">
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    </section>
  </article>
</div>
